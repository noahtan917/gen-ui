{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gen-ui.local/contracts/components.schema.json",
  "title": "GenUIComponents",
  "$defs": {
    "component": {
      "type": "object",
      "required": ["id", "type", "props"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["Stack", "Text", "Button", "Card", "Image", "Form", "Select", "Chart"]
        },
        "actionId": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "Button" } },
            "required": ["type"]
          },
          "then": { "required": ["actionId"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "Form" } },
            "required": ["type"]
          },
          "then": { "required": ["actionId"] }
        }
      ]
    }
  }
}
