{
  "source": "youtube",
  "id": "youtube",
  "colors": {
    "primary": "#FF0000",
    "primaryHover": "#CC0000",
    "surface": "#FFFFFF",
    "surfaceAlt": "#F9F9F9",
    "surfaceDark": "#0F0F0F",
    "text": "#0F0F0F",
    "textOnDark": "#FFFFFF",
    "textMuted": "#606060",
    "border": "#E5E5E5"
  },
  "typography": {
    "fontFamily": "Roboto, Arial, Helvetica, sans-serif",
    "scale": {
      "body": "1rem",
      "heading": "1.25rem",
      "caption": "0.875rem"
    }
  },
  "spacing": {
    "unit": 4,
    "sm": 8,
    "md": 16,
    "lg": 24
  },
  "radius": {
    "sm": "4px",
    "md": "12px"
  },
  "shadows": {
    "card": "0 1px 2px rgba(0, 0, 0, 0.1)"
  }
}
